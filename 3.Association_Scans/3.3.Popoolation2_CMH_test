## POOL-SEQ ASSOCIATION MAPPING - CMH ANALYSIS

#1. CREATE MPILEUP WITH SAMTOOLS: 
#Create mpileup based on the 4 phenotypic bams

	samtools mpileup -B -q 20 -Q 20 --positions ../DNA_damage/frenata_final_all_pops_vison_min5-sites.damfilt.txt --reference ../vison/GCF_020171115.1_ASM_NN_V1_genomic.fna ../0_merged/Brown_samples_east_frenata.bam ../0_merged/White_samples_east_frenata.bam ../0_merged/Brown_samples_west_frenata.bam ../0_merged/White_samples_west_frenata.bam > frenata_allpops_final_min5.vison.damfilt.mpileup

#2. FIX MPILEUP TO INDEL FILTERING:
#Fixe mpileup to avoid errors in sync production:

	sed 's/\t\t/\t!\t!/g' frenata_allpops_final_min5.vison.damfilt.mpileup > frenata_allpops_final_min5.vison.damfilt.fixed.mpileup


#3. CREATE SYNC WITH POPOOLATION2:

	java -ea -Xmx7g -jar ../bin/popoolation2_1201/mpileup2sync.jar --input frenata_allpops_final_min5.vison.damfilt.fixed.mpileup --output frenata_allpops_final_min5.vison.damfilt.fixed.sync --fastq-type sanger --min-qual 20


#4. INDENTIFY INDELS WITH POPOOLATION2:

	perl ../bin/popoolation2_1201/indel_filtering/identify-indel-regions.pl --input frenata_allpops_final_min5.vison.damfilt.fixed.mpileup --output frenata_allpops_final_min5.vison.damfilt.fixed.indels.gtf --indel-window 5


#5. FILTER INDELS IN SYNC WITH POPOOLATION2:

	perl ../bin/popoolation2_1201/indel_filtering/filter-sync-by-gtf.pl --gtf frenata_allpops_final_min5.vison.damfilt.fixed.indels.gtf --input frenata_allpops_final_min5.vison.damfilt.fixed.sync --output frenata_allpops_final_min5.vison.damfilt.fixed.filtered.sync


#6. CMH TEST

	cmh-test.pl --input frenata_allpops_final_min5.vison.damfilt.corrected2.sync --output frenata_allpops_final_min5.vison.damfilt.corrected2.mincount3_mincov5.cmh --min-count 3 --min-coverage 5 --max-coverage 33,33,33,33 --population 1-2,3-4

